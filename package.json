{
  "name": "dsh-task-collaboration",
  "version": "0.1.0",
  "description": "Task-scoped durable context shared across DeepSeek Harness sessions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./task": {
      "types": "./dist/task/index.d.ts",
      "default": "./dist/task/index.js"
    },
    "./task-context-sync": {
      "types": "./dist/task-context-sync/index.d.ts",
      "default": "./dist/task-context-sync/index.js"
    },
    "./tool-task-context": {
      "types": "./dist/tool-task-context/index.d.ts",
      "default": "./dist/tool-task-context/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run build && pnpm pack --pack-destination .pack",
    "prepare": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.15.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SLin-code/dsh-task-collaboration.git"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-storage": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-storage-json": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.2"
  }
}
